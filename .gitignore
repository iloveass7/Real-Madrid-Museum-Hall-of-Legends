*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.env
*.venv

# Development & Test Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Temporary & Cache Directories
.cache/
.parcel-cache/
tmp/
temp/
